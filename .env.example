# Senha do painel /admin. Sem ela, /admin fica inacessível (redireciona
# sempre para o login) e a rota de login retorna erro 500.
ADMIN_PASSWORD=

# URLs das collections do mockapi.io (mesmo serviço usado no projeto do
# Blog). Crie um projeto em https://mockapi.io, adicione duas collections
# — "projects" e "certificates" — e cole aqui as URLs base de cada uma
# (algo como https://xxxxx.mockapi.io/projects).
#
# Sem essas variáveis, o site funciona normalmente usando os dados semente
# fixos em lib/data.ts — só o painel /admin fica sem efeito (mostra um
# aviso pedindo para configurar).
NEXT_PUBLIC_MOCKAPI_PROJECTS_URL=
NEXT_PUBLIC_MOCKAPI_CERTIFICATES_URL=

# Formulário de contato — canal principal: e-mail via Resend
# (https://resend.com). Crie uma conta com o mesmo e-mail que você quer
# receber as mensagens (thiagobrsoares3011@gmail.com) e copie a API key.
# Sem domínio verificado, o Resend só permite enviar para o e-mail da
# própria conta — perfeito para este caso, já que o destino é você mesmo.
RESEND_API_KEY=

# Opcional — só se quiser mudar o destinatário sem trocar a conta Resend.
# CONTACT_EMAIL_TO=thiagobrsoares3011@gmail.com

# Formulário de contato — backup opcional: além do e-mail, também salva
# cada mensagem numa terceira collection do mockapi.io, o que alimenta a
# aba "Mensagens" do painel /admin. Sem NEXT_PUBLIC_ de propósito — só é
# lida no servidor (app/api/contact/route.ts), nunca exposta ao navegador.
# Funciona com RESEND_API_KEY, com MOCKAPI_MESSAGES_URL, ou com os dois —
# só precisa de pelo menos um configurado.
MOCKAPI_MESSAGES_URL=
